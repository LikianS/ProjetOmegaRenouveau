  dialogueLines:
  - id: 0
    speakerName: Kael
    dialogueText: "Tiens donc... un nouveau guerrier. T\u2019as l\u2019air d\xE9termin\xE9.
      Bienvenue au Refuge, le dernier bastion avant les terres maudites.  Tout ici
      est pens\xE9 pour te pr\xE9parer \xE0 ce qui t\u2019attend l\xE0-bas."
    isPlayerSpeaking: 0
    nextDialogueId: 1
    choices: []
    opensShop: 0
    shopType: 
    opensQuest: 0
