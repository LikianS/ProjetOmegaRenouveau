  - id: 5
    speakerName: Jarn
    dialogueText: "Tu veux devenir un vrai guerrier ? Alors frappe, pare, bouge.
      Ici, tu ne peux pas mourir. Mais dehors, tu n\u2019auras pas cette chance."
    isPlayerSpeaking: 0
    nextDialogueId: -1
    choices:
    - choiceText: Je vais m'entrainer un peu.
      nextDialogueId: -1
      opensShop: 0
      shopType: 
    - choiceText: Rappelle-moi les commandes.
      nextDialogueId: 0
      opensShop: 0
