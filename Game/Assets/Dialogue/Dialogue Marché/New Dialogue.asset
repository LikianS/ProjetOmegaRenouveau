  dialogueLines:
  - id: 0
    speakerName: Pedro
    dialogueText: "Ah, un nouveau visage ! Tu dois \xEAtre le combattant dont tout
      le monde parle. Bienvenue au march\xE9 de Valemont !"
    isPlayerSpeaking: 0
    nextDialogueId: 1
    choices: []
    opensShop: 0
    shopType: 
    opensQuest: 0
    quest: {fileID: 0}
    updatesQuestStep: 0
    questStepId: -1
