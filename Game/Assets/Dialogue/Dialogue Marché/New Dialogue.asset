  - id: 1
    speakerName: Bob
    dialogueText: "Tu peux me montrer ce qu\u2019on peut trouver ici ?"
    isPlayerSpeaking: 1
    nextDialogueId: 2
    choices: []
    opensShop: 0
    shopType: 
    opensQuest: 0
    quest: {fileID: 0}
    updatesQuestStep: 0
    questStepId: -1
