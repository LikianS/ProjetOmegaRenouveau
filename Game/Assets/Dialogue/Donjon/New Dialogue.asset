  dialogueLines:
  - id: 0
    speakerName: Varek
    dialogueText: "Tu sens \xE7a ? Ce frisson dans l\u2019air\u2026 Ce n\u2019est
      pas le vent. C\u2019est le donjon qui t\u2019appelle. Et crois-moi\u2026 il
      ne murmure pas, il hurle."
    isPlayerSpeaking: 0
    nextDialogueId: 1
    choices: []
    opensShop: 0
    shopType: 
    opensQuest: 0
    quest: {fileID: 11400000, guid: a1b32e5aca3df3549b9aed92cc7fb76f, type: 2}
    updatesQuestStep: 0
    questStepId: 6
    requiredQuests: []
