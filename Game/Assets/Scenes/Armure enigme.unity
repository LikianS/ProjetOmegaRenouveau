  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Le Dragon, cr\xE9ature l\xE9gendaire, se cache dans l\u2019obscurit\xE9
    de la for\xEAt. Il ne viendra pas \xE0 l\u2019appel du h\xE9ros s\u2019il se
    trouve \xE0 l\u2019extr\xE9mit\xE9 gauche du royaume. Le blason du Dragon ne
    peut jamais \xEAtre port\xE9 par l\u2019armure qui occupe la place la plus \xE0
    gauche\n\nMais ce n\u2019est pas tout. Il existe une \xE9p\xE9e magique, forg\xE9e
    dans le feu des volcans. Seul le plus audacieux des chevaliers, celui qui se
    tiendra \xE0 la place la plus \xE0 gauche, pourra brandir cette \xE9p\xE9e. Aucun
    autre guerrier n\u2019osera la tenir. L\u2019\xC9p\xE9e, toujours \xE0 gauche,
    est l\u2019embl\xE8me du courage et de la noblesse.\n\nIl existe \xE9galement
    une masse puissante, que l\u2019on dit capable de briser les montagnes. Cette
    arme est li\xE9e \xE0 un autre blason : celui du Cerf. Celui qui rev\xEAt ce
    blason porte la Masse et s\u2019\xE9lance dans la bataille avec une force in\xE9gal\xE9e.
    Mais attention : ce n\u2019est pas l\u2019armure qui se trouve \xE0 l\u2019extr\xE9mit\xE9
    droite qui portera la Masse. Le myst\xE8re se cache ailleurs\u2026\n\n "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
